(def n (let (e (getenv "BENCH_N")) (if e (string->number e) 30000)))

(defn steps (m s)
  (cond (= m 1)           s
        (= (rem m 2) 0)   (steps (quot m 2) (+ s 1))
        :else             (steps (+ (* 3 m) 1) (+ s 1))))

(defn scan (k best)
  (if (>= k n) best
    (scan (+ k 1) (max best (steps k 0)))))

(println (scan 1 0))
