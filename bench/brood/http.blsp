;; Concurrent HTTP: fire N GETs at a local server (each request sleeps ~20ms
;; server-side), one green process per request, and count the 200s. Brood's TCP
;; is message-based — `http-get` parks its process on a `receive`, so all N
;; requests are in flight at once rather than serialising. Checksum = N.
;;
;; net/* ships in the default install — http is a bundled std module
;; (ADR-097, amends ADR-085 Move 2), so `require` resolves it straight from the
;; `brood` binary with no load-path setup.
(require 'http)

(def n (let (e (getenv "BENCH_N")) (if e (string->number e) 500)))
(def port (let (e (getenv "BENCH_HTTP_PORT")) (if e e "8089")))
(def url (str "http://127.0.0.1:" port "/"))

;; parent pid captured at top level (inside the child (self) would differ).
(def me (self))

;; `http/http-get` must run inside a process (it `receive`s the response).
(defn worker () (send me [:r (if (= (get (http/http-get url) :status) 200) 1 0)]))

(defn fan (i) (if (>= i n) nil (do (spawn (worker)) (fan (+ i 1)))))

(defn collect (got acc)
  (if (= got n)
    acc
    (collect (+ got 1) (receive ([:r v] (+ acc v))))))

(fan 0)
(println (collect 0 0))
