;; Generate N bytes (LCG mod 256), base64-encode then decode. Checksum =
;; (sum of encoded char codes + sum of decoded bytes) mod 2^31 — exercises and
;; verifies both directions. Brood's base64 is pure-Brood (std/encoding) vs the
;; native codecs elsewhere.
(def n (let (e (os/env "BENCH_N")
             v (if e (string/->number e) 50000))
         (if (failure? v) (throw (str "BENCH_N is not a number: " e)) v)))

(defn gen (i x acc)
  (if (>= i n)
    acc
    (let (x2 (bit/and (+ (* x 1103515245) 12345) 2147483647))
      (gen (+ i 1) x2 (cons (math/rem x2 256) acc)))))

;; `decoded` where the other six say `dec`: `dec` is the prelude's decrement, and
;; ADR-166 reserves every name that ships in the binary.
(def bs (reverse (gen 0 123456789 (list))))
(def enc (encoding/base64-encode-bytes bs))
(def decoded (let (d (encoding/base64-decode-bytes enc))
               ;; The input is our OWN encoder's output, so a failure here is a codec
               ;; bug, not bad input — this row claims to verify both directions.
               (if (failure? d) (throw (str "base64 round-trip failed: " (error-message d))) d)))
(def enc-sum (reduce (string/->codepoints enc) 0 (fn (a c) (math/rem (+ a c) 2147483647))))
(def dec-sum (reduce decoded 0 (fn (a b) (math/rem (+ a b) 2147483647))))
(io/puts (math/rem (+ enc-sum dec-sum) 2147483647))
