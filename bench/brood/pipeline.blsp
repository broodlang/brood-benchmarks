(def n (let (e (getenv "BENCH_N")) (if e (string/->number e) 100000)))

;; map / filter / reduce pipeline over a range: keep the multiples of 3 or 5,
;; square them, sum the squares. Checksum = that sum.
;;
;; Uses the LAZY/streaming form (`lfilter`/`lmap`) — the fair match to the
;; lazy/streaming pipelines the other languages use here: Elixir `Stream`,
;; Python generator expression, and .NET LINQ all stream without building
;; intermediate collections. Brood's `lfilter`/`lmap` build lazy sequences, so the
;; range flows through filter → map → reduce one element at a time (no fully
;; materialized intermediate lists). The eager `(->> (range n) (filter …) (map …)
;; (reduce …))` is still idiomatic Brood and would build a cons list per stage.
(defn mult35? (i) (or (= 0 (rem i 3)) (= 0 (rem i 5))))

(io/puts (->> (range n)
           (lfilter mult35?)
           (lmap (fn (i) (* i i)))
           (reduce + 0)))
