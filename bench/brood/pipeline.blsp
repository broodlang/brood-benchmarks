(def n (let (e (getenv "BENCH_N")) (if e (string->number e) 100000)))

;; map / filter / reduce pipeline over a range: keep the multiples of 3 or 5,
;; square them, sum the squares. Checksum = that sum.
;;
;; Uses the FUSED form (`eduction` over transducers) — the fair match to the
;; lazy/streaming pipelines the other languages use here: Elixir `Stream`,
;; Python generator expression, and .NET LINQ all fuse without building
;; intermediate collections. Brood's `eduction` does the same (compute-frontier
;; lever 3c / ADR-111): one pass over the range, no intermediate lists. The eager
;; `(->> (range n) (filter …) (map …) (reduce …))` is still idiomatic Brood and
;; would build a cons list per stage (~3× slower, ~13× more memory at n=1e6).
(defn mult35? (i) (or (= 0 (rem i 3)) (= 0 (rem i 5))))

(println
  (reduce + 0
    (eduction (xfilter mult35?) (xmap (fn (i) (* i i))) (range n))))
