(def n (let (e (getenv "BENCH_N")) (if e (string->number e) 540)))
(def maxi 100)

;; carry xx=x*x and yy=y*y so each is computed once per iteration, not ~5×
(defn esc (x y xx yy x0 y0 i)
  (if (and (<= (+ xx yy) 4.0) (< i maxi))
    ;; ny uses the OLD x and y; nx uses the OLD xx and yy — bind both off the
    ;; current values before stepping.
    (let (ny (+ (* 2.0 (* x y)) y0)
          nx (+ (- xx yy) x0))
      (esc nx ny (* nx nx) (* ny ny) x0 y0 (+ i 1)))
    i))

(defn row-sum (px py acc)
  (if (>= px n)
    acc
    ;; `->float` before dividing, matching every other port (Clojure `(double py)`,
    ;; .NET `(double)py`, Ruby `py.to_f`; Python/Node/Elixir `/` is float division).
    ;; Brood's `/` is EXACT (ADR-196), so `(/ px n)` on two ints builds a rational —
    ;; 291,600 of them here, each converted straight to float by the `* 3.0`. That is
    ;; strictly more work than the other ports do for an identical checksum, so the row
    ;; stopped measuring escape-time float compute and started measuring rational
    ;; construction: 192 ms -> 668 ms when exact rationals landed, checksum unchanged.
    (let (x0 (- (* (/ (->float px) n) 3.0) 2.0)
          y0 (- (* (/ (->float py) n) 3.0) 1.5))
      (row-sum (+ px 1) py (+ acc (esc 0.0 0.0 0.0 0.0 x0 y0 0))))))

(defn grid-sum (py acc)
  (if (>= py n)
    acc
    (grid-sum (+ py 1) (+ acc (row-sum 0 py 0)))))

(println (grid-sum 0 0))
