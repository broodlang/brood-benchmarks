;; Hold N concurrent units alive, then send each one a MESSAGE IT MUST COPY.
;;
;; The point of the row is to compare units that provide the same guarantees:
;;   * isolated state — each unit owns data no other unit can reach
;;   * copied messages — the receiver cannot observe the sender's later mutations
;;   * preemptive scheduling — one unit looping cannot starve the rest
;;
;; An earlier version just woke each unit and had it return 1. That let the
;; coroutine runtimes (Node promises, .NET Tasks, asyncio) score 0.15-0.20s by
;; doing nothing at all: no isolation to pay for, no copy, no contention. Passing
;; a payload each unit must *own* is what makes the comparison mean something —
;; in Brood and on the BEAM the copy is what `send` already does; the other ports
;; have to do it explicitly, because passing a reference is not the same operation.
;;
;; Checksum = N * (sum of the payload + 1).
(def n (let (e (getenv "BENCH_N")) (if e (string->number e) 300000)))
(def payload (range 16))           ; 0..15, sum 120
(def me (self))

;; Each unit parks holding its own id, then folds the payload it receives.
(defn unit (id)
  (receive ([:go p] (send me [:r (+ (fold + 0 p) 1)]))))

(defn spawn-all (i acc) (if (>= i n) acc (spawn-all (+ i 1) (cons (spawn (unit i)) acc))))
(defn release (l) (if (empty? l) nil (do (send (first l) [:go payload]) (release (rest l)))))
(defn collect (got acc) (if (= got n) acc (collect (+ got 1) (receive ([:r v] (+ acc v))))))

(def kids (spawn-all 0 nil))
(release kids)
(println (collect 0 0))
