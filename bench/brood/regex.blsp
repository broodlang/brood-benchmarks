;; Generate N decimal strings (LCG); append "x" to the even ones to break a full
;; match; count how many fully match [0-9]+. Uses [0123456789] (explicit set, no
;; ranges) so every engine agrees exactly. Checksum = count of full matches.
;;
;; Since brood 0.33 (ADR-389, 2026-09-23) std/regex keeps the pattern LANGUAGE in Brood —
;; its parser, translated once and memoised — and matches with a native engine
;; (regex-automata). So this row measures a Brood call into native matching against the
;; other runtimes' native matching: a like-for-like comparison, and no longer a signal
;; about the interpreter. Brood columns measured before 0.33 timed the pure-Brood DFA.
(def n (let (e (os/env "BENCH_N")
             v (if e (string/->number e) 20000))
         (if (int? v) v (throw (str "BENCH_N is not an integer: " e)))))

(defn go (i x acc)
  (if (>= i n)
    acc
    (let (x2 (bit/and (+ (* x 1103515245) 12345) 2147483647)
          s0 (str x2)
          s (if (= (math/rem x2 2) 0) (str s0 "x") s0)
          hit (if (regex/matches? "[0123456789]+" s) 1 0))
      (go (+ i 1) x2 (+ acc hit)))))

(io/puts (go 0 123456789 0))
