(def n (let (e (getenv "BENCH_N")) (if e (string->number e) 750000)))
(def md 1000000007)

(defn gen (x i acc)
  (if (>= i n)
    acc
    (let (x2 (bit-and (+ (* x 1103515245) 12345) 2147483647))
      (gen x2 (+ i 1) (cons x2 acc)))))

(def data (sort (gen 123456789 0 nil)))

;; order-sensitive polynomial hash over the sorted sequence
(defn hash--acc (lst h)
  (if (empty? lst)
    h
    (hash--acc (rest lst) (rem (+ (* h 31) (first lst)) md))))

(println (hash--acc data 0))
