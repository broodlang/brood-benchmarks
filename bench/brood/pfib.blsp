;; Parallel fib: compute fib(N) in 100 independent green processes at once and
;; sum the results. Brood spawns 100 lightweight processes; the scheduler runs
;; them across all cores. Checksum = 100 * fib(N).
(def n (let (e (os/getenv "BENCH_N")) (if e (string/->number e) 31)))
(def tasks 100)

(defn fib (m) (if (< m 2) m (+ (fib (- m 1)) (fib (- m 2)))))

;; parent pid captured at top level — inside the child (self) would differ.
(def me (self))

(defn fan (i) (if (>= i tasks) nil (do (spawn (send me [:r (fib n)])) (fan (+ i 1)))))

(defn collect (got acc)
  (if (= got tasks)
    acc
    (collect (+ got 1) (receive ([:r v] (+ acc v))))))

(fan 0)
(io/puts (collect 0 0))
