(def n (let (e (os/getenv "BENCH_N")) (if e (string/->number e) 150000)))

;; all-integer trial division: in Brood the (* d d) multiply is CHEAPER than
;; comparing d to a float sqrt bound (mixed int/float compare coerces) — so we
;; keep d*d here even though hoisting sqrt is the win in Python/Node.
(defn divides-none? (m d)
  (cond
    (> (* d d) m) true
    (= (rem m d) 0) false
    else (divides-none? m (+ d 1))))

(defn prime? (m) (if (< m 2) false (divides-none? m 2)))

(defn count-primes (k acc)
  (if (>= k n)
    acc
    (count-primes (+ k 1) (if (prime? k) (+ acc 1) acc))))

(io/puts (count-primes 2 0))
