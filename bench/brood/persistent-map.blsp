;; Read-modify-write churn on a persistent map over a large key space (50k keys,
;; so the CHAMP trie is deep and each update path-copies real depth — unlike
;; wordcount's shallow 1k-key map). Each step is a fused single-descent RMW
;; (`map-int-add`, the same idiom wordcount uses) — the faithful counterpart of
;; the other ports' one-call update (Elixir `Map.update/4`, Node `map.set`,
;; Python `d[k] = d.get(k,0)+d`): read-old + path-copy in ONE trie walk, not a
;; separate `get` descent followed by an `assoc` descent.
;; Checksum = sum of key*value over the map.
(def n (let (e (os/getenv "BENCH_N")) (if e (string/->number e) 300000)))
(def m 50000)

(defn go (i x acc)
  (if (>= i n)
    acc
    (let (x2 (bit-and (+ (* x 1103515245) 12345) 2147483647)
          key (rem x2 m))
      (go (+ i 1) x2 (map-int-add acc key (+ 1 (rem key 7)))))))

(def final (go 0 123456789 {}))
(io/puts (reduce (fn (a kv) (let ([k v] kv) (+ a (* k v)))) 0 final))
