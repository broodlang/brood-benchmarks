;; Read-modify-write churn on a persistent map over a large key space (50k keys,
;; so the CHAMP trie is deep and each update path-copies real depth — unlike
;; wordcount's shallow 1k-key map). Each step is the plain read-modify-write a Brood
;; user writes — `(assoc m k (+ (get m k 0) …))` — the counterpart of the other ports'
;; `Map.update/4` / `map.set` / `d[k] = d.get(k, 0) + …`. It used to call
;; `%map-int-add`, an undocumented kernel primitive that only the compiler's linear-map
;; rewrite recognised (5× faster: the accumulator is provably linear, so the map is built
;; in place); that is not code a user would write (the benchmark's rule is idiomatic, not
;; adversarial), so the port was changed to the idiom and brood taught to recognise it
;; (brood ADR-360 / KI-151). The two now compile to the same thing.
;; Checksum = sum of key*value over the map.
(def n (let (e (os/env "BENCH_N")
             v (if e (string/->number e) 300000))
         (if (int? v) v (throw (str "BENCH_N is not an integer: " e)))))
(def m 50000)

(defn go (i x acc)
  (if (>= i n)
    acc
    (let (x2 (bit/and (+ (* x 1103515245) 12345) 2147483647)
          key (math/rem x2 m))
      (go (+ i 1) x2 (assoc acc key (+ (get acc key 0) (+ 1 (math/rem key 7))))))))

(def final (go 0 123456789 {}))
(io/puts (reduce final 0 (fn (a kv) (let ([k v] kv) (+ a (* k v))))))
