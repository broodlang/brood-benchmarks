;; Read-modify-write churn on a persistent map over a large key space (50k keys,
;; so the CHAMP trie is deep and each assoc path-copies real depth — unlike
;; wordcount's shallow 1k-key map). Checksum = sum of key*value over the map.
(def n (let (e (getenv "BENCH_N")) (if e (string->number e) 300000)))
(def m 50000)

(defn go (i x acc)
  (if (>= i n) acc
    (let (x2  (bit-and (+ (* x 1103515245) 12345) 2147483647)
          key (rem x2 m)
          nv  (+ (get acc key 0) (+ 1 (rem key 7))))
      (go (+ i 1) x2 (assoc acc key nv)))))

(def final (go 0 123456789 {}))
(println (reduce (fn (a kv) (let ([k v] kv) (+ a (* k v)))) 0 final))
