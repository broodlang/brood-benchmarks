(def n (let (e (os/env "BENCH_N")) (if e (string/->number e) 30000000)))

;; raw iteration: tail-recursive count with an accumulator (TCO, O(1) stack).
;; Accumulate the index (not a constant), so the checksum = sum 0..n-1 is
;; path-dependent — it catches an off-by-one in the loop bound, which `+ 1`
;; (checksum = n, just echoing the input) would not.
(defn- loop-acc (i acc) (if (>= i n) acc (loop-acc (+ i 1) (+ acc i))))

(io/puts (loop-acc 0 0))
