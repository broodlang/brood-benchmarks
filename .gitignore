# Brood package cache — regenerable from project.lock.blsp (which is committed)
_deps/

# Editor / OS cruft
*.swp
.DS_Store

# Python bytecode caches (anywhere in the tree)
__pycache__/
*.py[cod]

# Crash dumps (BEAM / Brood) — regenerable, not source
erl_crash.dump
.brood_crash_dump

# .NET build artifacts (regenerable; the harness rebuilds via `dotnet build`)
bench/dotnet/bin/
bench/dotnet/obj/
bench/dotnet/publish/

# Per-machine benchmark runs (harness --label X). The canonical reference
# numbers live in results/results.json + results/report.md; machine-specific
# runs are not comparable across hardware, so they stay out of history.
results/results.*.json
results/report.*.md
bench/elixir/_build/
bench/clojure/.cpcache/
