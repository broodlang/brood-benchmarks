(defmodule bench/docs
  "Regenerate every derivable number in BENCHMARKS.md and README.md from results.json.

    nest run -- docs             ; rewrite in place
    nest run -- docs --check  ; exit 1 if stale (run before committing)

Owns: anything between `<!-- BEGIN NAME -->` / `<!-- END NAME -->` (MACHINE, SCOREBOARD,
LATENCY, PEER, COROUTINE in BENCHMARKS.md; STANDINGS, ENVIRONMENT in README.md), plus every
ordered per-row table — its times, `Brood rank`, `vs best`, `vs avg`, and the score line
above it. Language columns come from each table's own header, so re-ordering one is honoured.

Prose is hand-written. Cite a number in prose only where the argument needs it: a figure
typed into a sentence is stale after the next run, which is why this tool exists (on
2026-08-05 a hand-publish left six tables, the run date and the brood commit describing the
previous run).

Python's dicts kept insertion order and this tool's arithmetic leans on it (which column a
tie goes to, the order a geometric mean sums its logs in). A Brood map has none, so every
such order is explicit: languages in `bench/rows`'s `lang-order`, rows in its `row-names`,
table columns in the header's own order."
  (:use bench/rows)
  (:use bench/common))

(def docs ["BENCHMARKS.md" "README.md"])

;; The name the markers carry. The committed docs were generated by the Python tool and say
;; so; keeping the same text keeps a regeneration byte-identical. Change it here (one diff
;; in each doc's markers) once the Python tool is gone.
(def generated-by "nest run -- docs")

;; `common`'s `lang-col` is a map; the scoreboard lists its columns in this order.
(def lang-col-order ["C" ".NET" "Elixir" "Node" "Brood" "Ruby" "Python" "Clojure" "Go"])

(def begin-re "^<!-- BEGIN ([A-Z_]+)(?: \\(generated by [^)]*\\))? -->")

(defn- begin (block) (str "<!-- BEGIN " block " (generated by " generated-by ") -->"))

(defn- end (block) (str "<!-- END " block " -->"))

;; ---- numbers, formatted the way Python formatted them -----------------------------

(defn- fl (x) (* 1.0 x))

(defn- truthy? (v)
  "Python's truthiness of a number: nil and zero are false."
  (and (not (nil? v)) (not (math/zero? v))))

(defn- round-int (x)
  "Python's `round(x)`: to the nearest integer, a tie to the even one."
  (let (f (math/floor x)
        d (- x f))
    (cond
      (> d 0.5) (inc f)
      (< d 0.5) f
      (math/even? f) f
      else (inc f))))

(defn- fixed (x n) (math/->fixed (fl x) n))

(defn- group-thousands (digits &optional (grouped ""))
  "`digits` with a comma before every third digit from the right."
  (let (n (string/length digits))
    (if (<= n 3)
      (str digits grouped)
      (group-thousands (string/substring digits 0 (- n 3))
        (str "," (string/substring digits (- n 3) n) grouped)))))

(defn- thousands (v)
  "Python's `f\"{v:,}\"` — thousands separators on the integer part."
  (let (text (str v)
        negative (string/starts-with? text "-")
        body (if negative (string/substring text 1 (string/length text)) text)
        dot (index-of body ".")
        whole (if (>= dot 0) (string/substring body 0 dot) body)
        fraction (if (>= dot 0) (string/substring body dot (string/length body)) ""))
    (str (if negative "-" "") (group-thousands whole) fraction)))

(defn- min-of (xs) (apply math/min (vec xs)))

(defn- cores (d) (/ (fl (or (get d :cpu_pct) 0)) 100.0))

(defn- cpu-s (d)
  (if (get d :cpu_pct) (* (/ (fl (get d :wall_ms)) 1000.0) (cores d)) nil))

(defn- fmt-s (ms)
  (if (>= ms 1000) (str (fixed (/ (fl ms) 1000) 2) " s") (str (round-int ms) " ms")))

(defn- fmt-gb (kb)
  (if (>= kb 1048576)
    (str (fixed (/ (fl kb) 1048576) 2) " GB")
    (str (round-int (/ (fl kb) 1024)) " MB")))

(defn- fmt-ms (v)
  (cond
    (nil? v) "—"
    ;; a cell at the startup-subtraction floor
    (< v 1) "&lt;1ms"
    (< v 1000) (str (round-int v) "ms")
    else (str (fixed (/ (fl v) 1000) 1) "s")))

(defn- dot (ratio)
  "Band for a Brood-vs-other *ratio*: 🟢 at least as fast, 🟠 up to 3× slower, 🔴 beyond.
Emoji rather than CSS because GitHub strips `style` attributes, so a `<span>` renders as
plain text."
  (cond
    (not (truthy? ratio)) ""
    (<= ratio 1.0) "🟢"
    (<= ratio 3.0) "🟠"
    else "🔴"))

(defn- signed (ratio)
  "A ratio as a signed factor: `+2.5×` = 2.5× slower, `−3.0×` = 3.0× faster. An unsigned
ratio makes the reader divide: `0.35×` is \"about three times faster\" only after
arithmetic, and a flat `best` label hides the margin entirely. Signed, both directions read
the same way and the sign carries the answer."
  (cond
    (not (truthy? ratio)) "—"
    (> ratio 1.0) (str "+" (fixed ratio 1) "×")
    (< ratio 1.0) (str "−" (fixed (/ 1.0 ratio) 1) "×")
    else "0×"))

;; ---- results access ---------------------------------------------------------------

(defn- row-langs-of (results name)
  "The languages row `name` has a record for, in `lang-order`."
  (in-order (map (keys (get (row results name) :langs)) ->string) lang-order))

(defn- compute-of (results starts name lang) (compute results starts name lang))

;; `values` throughout is a vector of `[display-name value]`, in column order — Python's
;; ordered dict.

(defn- others-of (values) (seq/filter values (fn ([n _]) (not (= n "Brood")))))

(defn- value-of (values name) (second (seq/find values (fn ([n _]) (= n name)))))

(defn- rating (brood values)
  "`vs best`: against the fastest *other* column when Brood leads (so the margin is
visible), against the fastest column otherwise."
  (let (others (seq/filter (map (others-of values) second) truthy?))
    (if (or (nil? brood) (empty? others))
      "—"
      (let (r (/ brood (min-of others))) (str (dot r) " " (signed r))))))

(defn- rating-avg (brood values)
  "`vs avg`: against the geometric mean of the other ports — see `bench/common`'s
`geomean` for why geometric (an arithmetic mean just tracks the slowest language)."
  (let (g (geomean (map (others-of values) second)))
    (if (not (and (truthy? brood) (truthy? g)))
      "—"
      (str (dot (/ brood g)) " " (signed (/ brood g))))))

(defn- strip-char (text ch)
  "Python's `text.strip(ch)` for a one-character `ch`: every leading and trailing `ch`."
  (cond
    (string/starts-with? text ch) (strip-char (string/substring text 1 (string/length text)) ch)
    (string/ends-with? text ch) (strip-char (string/substring text 0 (dec (string/length text))) ch)
    else text))

(defn- strip-leading-char (text ch)
  "Python's `text.lstrip(ch)` for a one-character `ch`."
  (if (string/starts-with? text ch)
    (strip-leading-char (string/substring text 1 (string/length text)) ch)
    text))

(defn- header-cells (header)
  "`[[display-name exact-cell-text] …]` — the cell text keeps footnote markers like
`<sup>p</sup>`, so columns can be reordered without losing them."
  (let (inner (strip-char (string/trim header) "|")
        cells (rest (map (string/split inner "|") string/trim))
        named (map cells (fn (cell) [(string/trim (regex/replace "<sup>.*?</sup>" cell "")) cell])))
    (vec (seq/filter named (fn ([n _]) (contains? lang-col n))))))

(defn- langs-of-header (header)
  "`[[display-name results-key] …]` in the header's current order."
  (vec (map (header-cells header) (fn ([name _]) [name (get lang-col name)]))))

(defn- versions (results) (get (get results :_meta) :versions))

(defn- version (results lang) (get (versions results) (keyword lang)))

(defn- strip-trailing-sha (text)
  (let (m (regex/find "\\s*\\([0-9a-f]{7,40}\\)\\s*$" text))
    (string/trim (if m (string/substring text 0 (get m :start)) text))))

(defn- brood-version (results)
  "`0.3.11 (`d5572d61`)` — the version with the commit attached exactly once.
`brood --version` grew a trailing `(hash)` of its own in 0.3.10; before that the harness's
separate `brood_commit` was the only source. Strip whatever the version string carries and
re-attach from `brood_commit`, so neither shape double-prints it (0.3.11 did: `Brood 0.3.11
(d5572d61) (`d5572d61`)`)."
  (let (ver (strip-trailing-sha (string/replace (version results "brood") "brood " ""))
        commit (get (get results :_meta) :brood_commit))
    (if commit (str ver " (`" commit "`)") ver)))

(defn- go-version (results)
  "`Go 1.24.2` from `go version go1.24.2 linux/amd64`."
  (let (m (regex/find "go(\\d+(?:\\.\\d+)+)" (or (version results "go") "")))
    (if m (str "Go " (get (first (get m :groups)) :text)) "Go")))

(defn- has-go? (results) (contains? (versions results) :go))

(defn- otp-form (elixir)
  "`… (compiled with Erlang/OTP 28)` → `… / OTP 28`."
  (let (m (regex/find " \\(compiled with Erlang/OTP (\\d+)\\)" elixir))
    (if m
      (str (string/substring elixir 0 (get m :start))
        " / OTP "
        (get (first (get m :groups)) :text)
        (string/substring elixir (get m :end) (string/length elixir)))
      elixir)))

(defn- date-of (results) (first (string/split (get (get results :_meta) :date) " ")))

(defn- linux-of (results) (nth (string/split (get (get results :_meta) :platform) "-") 1))

(defn- ruby-short (results) (first (string/split (version results "ruby") " (")))

(defn- machine-line (results)
  (let (meta (get results :_meta)
        date (date-of results)
        elixir (string/replace (otp-form (version results "elixir")) "Elixir " "")
        ;; A Brood-only refresh (the harness's `--langs brood` merged over the field)
        ;; updates the Brood column without re-measuring the others. The bare field date
        ;; then reads as "this page is stale" even though the Brood numbers are fresh —
        ;; surface the refresh date the merge records in `_meta.brood_refresh`.
        refresh-match (regex/find "re-measured (\\d{4}-\\d{2}-\\d{2})" (get meta :brood_refresh ""))
        refresh-date (if refresh-match (get (first (get refresh-match :groups)) :text) nil)
        ;; …and when that refresh ran on another machine (`brood_host`, written by
        ;; `bench/merge-brood`), say which: every cross-column ratio then compares two
        ;; machines, and a reader must not have to dig it out of results.json.
        brood-host (get meta :brood_host)
        refresh (cond
                  (and refresh-date brood-host)
                    (str " **Brood column re-measured "
                      refresh-date
                      " on `"
                      brood-host
                      "` ("
                      (get meta :brood_cores)
                      "-core)** — a different machine from the other columns, so ratios"
                      " across columns compare two machines.")
                  (and refresh-date (not (= refresh-date date)))
                    (str " **Brood column re-measured "
                      refresh-date "** (other columns from the field run).")
                  else ""))
    (str "Machine: `"
      (get meta :host)
      "`, "
      (get meta :cores)
      "-core x86-64, "
      "Linux "
      (linux-of results)
      ", **"
      date
      "** · Brood "
      (brood-version results)
      " · "
      (version results "clojure")
      " · Elixir "
      elixir
      " · "
      (version results "python")
      " · Node "
      (version results "node")
      " · Ruby "
      (string/replace (ruby-short results) "ruby " "")
      " · .NET "
      (version results "dotnet")
      (if (has-go? results) (str " · " (go-version results)) "")
      "."
      refresh)))

;; ---- the aggregates ---------------------------------------------------------------

(defn- startup-langs (results) (row-langs-of results "startup"))

(defn- sum-in-order (xs) (fold xs 0.0 +))

(defn- overall-numbers (results starts)
  "The aggregate figures README's standings table reports, computed once so its cells
cannot disagree."
  (let (c (fn (name lang) (compute-of results starts name lang))
        langs (seq/filter (startup-langs results)
                (fn (lang) (every? compute-rows (fn (r) (not (nil? (c r lang)))))))
        sums (into {}
               (map langs (fn (lang) [lang (sum-in-order (map compute-rows (fn (r) (c r lang))))])))
        best-sum (min-of (map langs (fn (lang) (get sums lang))))
        order (sort-by langs (fn (lang) (get sums lang)))
        ;; Against the field's typical runtime rather than its fastest: the geometric mean
        ;; of the other ports' aggregates, and how many rows Brood is ahead of that mean on.
        field-geo (geomean (map (seq/filter langs (fn (lang) (not (= lang "brood"))))
                             (fn (lang) (get sums lang))))
        avg-ratios (vec (seq/filter (map compute-rows
                                      (fn (r)
                                        (let (b (c r "brood")
                                              g (geomean (map (seq/filter langs
                                                                (fn (lang) (not (= lang "brood"))))
                                                           (fn (lang) (c r lang)))))
                                          (if (and (truthy? b) (truthy? g)) (/ b g) nil))))
                          (fn (x) (not (nil? x)))))
        ;; The OVERALL figure the overview chart plots: a geomean of per-row ratios across
        ;; every row all the languages implement, not just the eleven single-threaded ones.
        ;; Kept here so the chart and the standings table cannot drift apart — they were two
        ;; different aggregates over two different row sets until 2026-08-10, which is
        ;; exactly the kind of quiet disagreement this tool exists to prevent.
        ;;
        ;; The row set is the INTERSECTION of what each language completed, mirroring
        ;; `bench/chart` exactly. It used to require a language to implement every chart
        ;; row, which silently excluded any partial-coverage column — so when the C floor
        ;; column landed (16 of 31 rows) the chart rebased onto it and this figure did not,
        ;; and the two disagreed again. Intersecting here is what keeps them identical; the
        ;; cost is that adding a partial column NARROWS the row set for everyone, which is
        ;; a real editorial event and is called out in the prose rather than hidden.
        all-langs (seq/filter (startup-langs results)
                    (fn (lang) (any? chart-rows (fn (r) (not (nil? (c r lang)))))))
        all-rows (sort (seq/filter chart-rows
                         (fn (r) (every? all-langs (fn (lang) (not (nil? (c r lang))))))))
        all-best (into {}
                   (map all-rows (fn (r) [r (min-of (map all-langs (fn (lang) (c r lang))))])))
        raw-geo (vec (map all-langs
                       (fn (lang)
                         [lang
                           (geomean (for (r all-rows :when (truthy? (get all-best r)))
                                      (/ (c r lang) (get all-best r))))])))
        ;; Normalised to the leader, matching the chart — see `bench/chart` for why a raw
        ;; geomean of per-row ratios leaves nobody at 1.0x.
        lead (min-of (map raw-geo second))
        all-geo (into {} (map raw-geo (fn ([lang v]) [lang (/ v lead)])))
        all-order (sort-by all-langs (fn (lang) (get all-geo lang)))
        rank-of (fn (xs lang) (let (i (index-of (vec xs) lang)) (if (>= i 0) (inc i) nil))))
    {:agg-all (get all-geo "brood")
     :agg-all-rank (rank-of all-order "brood")
     :agg-all-rows (count all-rows)
     :agg-all-langs (count all-order)
     :agg-all-field (string/join (for (lang all-order :when (not (= lang "brood")))
                                   (str (get pretty lang) " " (fixed (get all-geo lang) 1)))
                      " · ")
     :agg-avg (if (truthy? field-geo) (/ (get sums "brood") field-geo) nil)
     :beats-avg (count (seq/filter avg-ratios (fn (x) (< x 1.0))))
     :navg (count avg-ratios)
     :agg (/ (get sums "brood") best-sum)
     :field (vec (for (lang order :when (not (= lang "brood"))) [lang (/ (get sums lang) best-sum)]))}))

;; the legacy blockquote form of a table's score, stripped on sight
(def score-prefix "> **Score")

(defn- row-values (results starts name cols)
  "`[[display value] …]` for row `name` over `cols`, every column (value nil when absent)."
  (vec (map cols (fn ([n k]) [n (compute-of results starts name k)]))))

(defn- truthy-values (values) (vec (seq/filter values (fn ([_ v]) (truthy? v)))))

(defn- normalized (per)
  "`per` is `[[display ratios] …]`; the geomean of each non-empty one, divided by the
leader's, as `[[display score] …]` in the same order — or nil when none."
  (let (raw (vec (for ([n v] per :when (not (empty? v))) [n (geomean v)])))
    (if (empty? raw)
      nil
      (let (lead (min-of (map raw second)))
        (vec (map raw (fn ([n r]) [n (/ r lead)])))))))

(defn- add-ratios (per vals)
  "Append each `vals` entry's ratio to the row's best onto its column in `per`."
  (let (lo (min-of (map vals second)))
    (vec (map per
           (fn ([n ratios])
             (let (v (value-of vals n))
               [n (if (nil? v) ratios (conj ratios (/ v lo)))]))))))

(defn- empty-per (cols) (vec (map cols (fn ([n _]) [n []]))))

(defn- score-map (results starts rows cols)
  "`[[display normalized-score] …]` for `rows` — the leader is exactly 1.00."
  (let (per (fold rows
              (empty-per cols)
              (fn (per name)
                (let (vals (truthy-values (row-values results starts name cols)))
                  (if (< (count vals) 2) per (add-ratios per vals))))))
    (or (normalized per) [])))

(defn- score-coverage (results starts rows cols)
  "`{display how-many-of-rows-it-has}`. A partial column (C) scores over the rows it runs,
which is the only thing it *can* do — but a 12-row geomean printed under a \"(15)\" heading
next to everyone else's 15-row one is a cross-subset comparison wearing a like-for-like
label. The scoreboard uses this to annotate the coverage instead of hiding it."
  (into {}
    (map cols
      (fn ([n k]) [n (count (seq/filter rows (fn (r) (truthy? (compute-of results starts r k)))))]))))

(defn- score-row (results starts rows cols)
  "The table's top row: every language's **normalized score** over that table's rows.

Per language, the geometric mean of `its time / that row's best time`, then divided by the
leader's so the fastest column reads exactly `1.00`. Geometric and per-row-relative because
a sum of milliseconds is dominated by the largest rows — ranking Brood 1st on the
like-for-like table purely because it beats .NET by 600 ms on `errors-deep`.

The trailing cells carry Brood's rank and its table-level `vs best` / `vs avg`."
  (let (state (fold rows
                {:per (empty-per cols) :best [] :avg [] :wins 0 :used 0}
                (fn (st name)
                  (let (vals (truthy-values (row-values results starts name cols))
                        b (value-of vals "Brood"))
                    (if (or (nil? b) (< (count vals) 2))
                      st
                      (let (lo (min-of (map vals second))
                            g (geomean (map (others-of vals) second)))
                        {:per (add-ratios (get st :per) vals)
                         :best (conj (get st :best) (/ b (min-of (map (others-of vals) second))))
                         :avg (if (truthy? g) (conj (get st :avg) (/ b g)) (get st :avg))
                         :wins (if (<= b lo) (inc (get st :wins)) (get st :wins))
                         :used (inc (get st :used))})))))
        used (get state :used)
        wins (get state :wins))
    (if (= used 0)
      nil
      (let (scores (normalized (get state :per))
            rank (inc (index-of (vec (map (sort-by scores second) first)) "Brood"))
            cells (map cols
                    (fn ([n _])
                      (let (s (value-of scores n))
                        (cond
                          (nil? s) "—"
                          (= n "Brood") (str "**" (fixed s 2) "**")
                          else (fixed s 2)))))
            gb (geomean (get state :best))
            ga (geomean (get state :avg))
            tail (str " | **"
                   rank
                   "/"
                   (count scores)
                   "** | "
                   (dot gb)
                   " "
                   (signed gb)
                   " | "
                   (dot ga)
                   " "
                   (signed ga)
                   " |")
            note (str "score (" used " rows)" (if (> wins 0) (str ", fastest on " wins) "")))
        (str "| **" note "** | " (string/join cells " | ") tail)))))

;; ---- the generated blocks ---------------------------------------------------------

(defn- latency-block (results starts)
  "The open-loop percentile table, ordered by p99 and rated against the best p99."
  (let (records (get (row results "latency") :langs)
        record (fn (lang) (get records (keyword lang)))
        metric (fn (lang k) (get (get (record lang) :metrics) k))
        langs (sort-by (seq/filter (row-langs-of results "latency")
                         (fn (lang) (get (record lang) :metrics)))
                (fn (lang) (metric lang :p99_us)))
        lines (map langs
                (fn (lang)
                  (let (d (record lang)
                        p99 (metric lang :p99_us)
                        others (sort (map (seq/filter langs (fn (x) (not (= x lang))))
                                       (fn (x) (metric x :p99_us))))
                        rate (if (empty? others) "—" (signed (/ (fl p99) (first others)))))
                    (str "| **"
                      (get pretty lang)
                      "** | "
                      (thousands (metric lang :p50_us))
                      " µs | **"
                      (thousands p99)
                      " µs** | "
                      (thousands (metric lang :p999_us))
                      " µs | "
                      (thousands (metric lang :max_us))
                      " µs | "
                      (fixed (cores d) 1)
                      "× | "
                      (fixed (cpu-s d) 2)
                      " | "
                      (round-int (/ (fl (get d :rss_kb)) 1024))
                      " MB | "
                      rate
                      " |")))))
    (append [(begin "LATENCY")
              "| | p50 | **p99** | p99.9 | max | cores | CPU·s | peak RSS | vs best (p99) |"
              "|---|---|---|---|---|---|---|---|---|"]
      lines
      [(end "LATENCY")])))

(defn- spawn-live-table (results starts langs label block)
  "`spawn-live` for a subset of the field — the peer table and the coroutine table."
  (let (records (get (row results "spawn-live") :langs)
        c (fn (lang) (compute-of results starts "spawn-live" lang))
        got (sort-by (seq/filter langs (fn (lang) (get records (keyword lang)))) c)
        lines (map got
                (fn (lang)
                  (let (d (get records (keyword lang))
                        v (c lang)
                        peers (sort (map (seq/filter got (fn (x) (not (= x lang)))) c)))
                    (str "| **"
                      (get pretty lang)
                      "** ("
                      (get label lang)
                      ") | "
                      (fmt-s v)
                      " | "
                      (fmt-gb (get d :rss_kb))
                      " | "
                      (fixed (cores d) 1)
                      "× | "
                      (fixed (cpu-s d) 2)
                      " | "
                      (if (empty? peers) "—" (signed (/ v (first peers))))
                      " |")))))
    (append [(begin block)
              "| | compute | peak RSS | cores | CPU·s | vs best |" "|---|---|---|---|---|---|"]
      lines
      [(end block)])))

(defn- peer-block (results starts)
  (spawn-live-table results
    starts
    ["elixir" "brood"]
    {"elixir" "BEAM process" "brood" "green process"}
    "PEER"))

(defn- coroutine-block (results starts)
  (spawn-live-table results
    starts
    ["node" "dotnet" "python" "go"]
    {"node" "promise" "dotnet" "`Task`" "python" "`asyncio` task" "go" "goroutine"}
    "COROUTINE"))

(defn- standings-block (results starts)
  "README's summary table: where Brood lands, and against whom."
  (let (o (overall-numbers results starts)
        c (fn (name lang) (compute-of results starts name lang))
        record (fn (name lang) (get (get (row results name) :langs) (keyword lang)))
        field (fn (name key unit scale)
                (let (vals (sort-by (for (lang (row-langs-of results name)
                                           :when (and (not (= lang "brood"))
                                             (not (nil? (get (record name lang) key)))))
                                      [(get pretty lang) (* (get (record name lang) key) scale)])
                             second))
                  (str (string/join (map vals (fn ([n v]) (str n " " (fixed v 1)))) ", ") unit)))
        ;; `startup` has no compute, and a percentile row (`latency`) is ranked by p99 — its
        ;; wall is N/rate by construction, so a compute rank there is not a fact about speed.
        candidates (seq/filter row-names
                     (fn (name)
                       (and (not (nil? (row results name)))
                         (not (= name "startup"))
                         (not (get (record name "brood") :metrics)))))
        computed (map candidates
                   (fn (name)
                     [name
                       (seq/filter (row-langs-of results name)
                         (fn (lang) (not (nil? (c name lang)))))]))
        ranked (for ([name ls] computed :when (and (includes? ls "brood") (>= (count ls) 3)))
                 [name (sort-by ls (fn (lang) (c name lang)))])
        firsts (for ([name order] ranked :when (= (first order) "brood")) (str "`" name "`"))
        lasts (for ([name order] ranked :when (= (last order) "brood")) (str "`" name "`"))
        sl (fn (lang) (record "spawn-live" lang))
        sup (fn (lang) (record "supervisor" lang))
        lm (fn (lang k) (get (get (record "latency" lang) :metrics) k))
        others (string/join (map (sort-by (seq/filter (row-langs-of results "latency")
                                            (fn (x)
                                              (and (not (= x "brood"))
                                                (get (record "latency" x) :metrics))))
                                   (fn (x) (lm x :p99_us)))
                              (fn (lang)
                                (str (get pretty lang)
                                  " "
                                  (lm lang :p99_us)
                                  " / "
                                  (lm lang :p999_us)
                                  " µs")))
                 " · ")
        or-dash (fn (xs) (if (empty? xs) "—" (string/join xs ", ")))
        startup-brood (record "startup" "brood"))
    [(begin "STANDINGS")
      (str "**"
        (date-of results)
        " run.** Numbers regenerate with each run; "
        "the full table is in [BENCHMARKS.md](BENCHMARKS.md).")
      ""
      "| | Brood | field |"
      "|---|---|---|"
      (str "| startup (wall) | "
        (fixed (get startup-brood :wall_ms) 1)
        " ms | "
        (field "startup" :wall_ms " ms" 1.0)
        " |")
      (str "| base RSS | "
        (fixed (/ (fl (get startup-brood :rss_kb)) 1024) 1)
        " MB | "
        (field "startup" :rss_kb " MB" (/ 1.0 1024))
        " |")
      (str "| overall speed — geomean of the "
        (get o :agg-all-rows)
        " rows every column implements "
        "| "
        (fixed (get o :agg-all) 1)
        "× the fastest ("
        (get o :agg-all-rank)
        "/"
        (get o :agg-all-langs)
        ") "
        "| "
        (get o :agg-all-field)
        " |")
      (str "| aggregate single-threaded compute | "
        (fixed (get o :agg) 1)
        "× the fastest | "
        (string/join (map (get o :field) (fn ([lang v]) (str (get pretty lang) " " (fixed v 1))))
          " · ")
        " |")
      (str "| aggregate vs the field's average | **"
        (fixed (get o :agg-avg) 2)
        "×** | "
        "ahead of the field average on "
        (get o :beats-avg)
        " of "
        (get o :navg)
        " core-compute rows |")
      (str "| rank by row | 1st on " (or-dash firsts) "; last on " (or-dash lasts) " | |")
      (str "| `spawn-live` (300k units held alive, each sent a copied message) | "
        (fmt-s (c "spawn-live" "brood"))
        ", "
        (fmt-gb (get (sl "brood") :rss_kb))
        ", "
        (fixed (cpu-s (sl "brood")) 2)
        " CPU·s | "
        "Elixir "
        (fmt-s (c "spawn-live" "elixir"))
        " / "
        (fmt-gb (get (sl "elixir") :rss_kb))
        " — the only peer; "
        (string/join (for (lang ["node" "dotnet" "python" "go"] :when (not (nil? (sl lang))))
                       (str (get pretty lang)
                         " "
                         (fmt-s (c "spawn-live" lang))
                         " / "
                         (fmt-gb (get (sl lang) :rss_kb))))
          ", ")
        " are coroutines on a shared heap |")
      (str "| `supervisor` (20k supervised children, a quarter retired and restarted) | "
        (fmt-s (c "supervisor" "brood"))
        ", "
        (fmt-gb (get (sup "brood") :rss_kb))
        " | "
        "Elixir "
        (fmt-s (c "supervisor" "elixir"))
        " / "
        (fmt-gb (get (sup "elixir") :rss_kb))
        " — the only peer; no other runtime here has a supervisor |")
      (str "| `latency` p99 / p99.9 (20k req/s, 5% of them occupying 500µs) | "
        "**"
        (lm "brood" :p99_us)
        " µs / "
        (lm "brood" :p999_us)
        " µs** | "
        others
        " — the "
        "compute winner has the worst tail |")
      (end "STANDINGS")]))

(defn- environment-block (results starts)
  (let (meta (get results :_meta)
        node (version results "node"))
    [(begin "ENVIRONMENT")
      (str "Numbers in the docs were measured on `"
        (get meta :host)
        "`: a "
        (get meta :cores)
        "-core x86-64 Linux "
        (linux-of results)
        " machine · Brood "
        (brood-version results)
        " (bytecode VM + tier-1 JIT) · "
        (string/replace (version results "clojure") " / JDK" " / OpenJDK")
        " (HotSpot) · "
        (otp-form (version results "elixir"))
        " (BeamAsm JIT) · "
        (version results "python")
        " · Node "
        (strip-leading-char node "v")
        " (V8) · "
        (ruby-short results)
        " · .NET "
        (version results "dotnet")
        " (RyuJIT)"
        (if (has-go? results) (str " · " (go-version results) " (gc)") "")
        ". "
        (date-of results)
        ".")
      (end "ENVIRONMENT")]))

(defn- block-lines (block results starts)
  (case block
    "MACHINE" [(begin "MACHINE") (machine-line results) (end "MACHINE")]
    "LATENCY" (latency-block results starts)
    "PEER" (peer-block results starts)
    "COROUTINE" (coroutine-block results starts)
    "STANDINGS" (standings-block results starts)
    "ENVIRONMENT" (environment-block results starts)
    nil))

(defn- scoreboard-block (results starts specs)
  "The top-of-document scoreboard: every table's normalized score, per language. Each
table's own top row says the same thing for that table; this is the one place that shows
all of them together, which is what \"how are we doing\" actually asks."
  (let (scored (vec (seq/filter (map specs
                                  (fn ([label cols rows])
                                    [label cols rows (score-map results starts rows cols)]))
                      (fn ([_ _ _ sm]) (not (empty? sm)))))
        ;; Only show a language column if some table can actually fill it. Without this,
        ;; adding a language to `lang-col` puts a permanently empty column in the
        ;; scoreboard — which is what happened when C landed: the header advertised C and
        ;; every cell read `·`, because the per-table scores come from each table's own
        ;; header and none of them listed C yet.
        present (into #{} (mapcat scored (fn ([_ _ _ sm]) (map sm first))))
        names (seq/filter lang-col-order (fn (n) (contains? present n)))
        head [(str "| table | " (string/join names " | ") " |")
               (str (string/repeat "|---" (inc (count names))) "|")]
        body (map scored
               (fn ([label cols rows sm])
                 (let (cover (score-coverage results starts rows cols)
                       cells (map names
                               (fn (n)
                                 (let (v (value-of sm n))
                                   (if (nil? v)
                                     "·"
                                     ;; Disclose a partial column rather than letting it read like
                                     ;; full coverage.
                                     (let (base (fixed v 2)
                                           covered (get cover n (count rows))
                                           txt (if (< covered (count rows))
                                                 (str base
                                                   "<sup>"
                                                   covered
                                                   "/"
                                                   (count rows)
                                                   "</sup>")
                                                 base))
                                       (if (= n "Brood") (str "**" txt "**") txt)))))))
                   (str "| " label " (" (count rows) ") | " (string/join cells " | ") " |")))))
    (append [(begin "SCOREBOARD")]
      head
      body
      [""
        (str "`1.00` = that table's fastest column; each score is the geometric mean of a "
          "language's time ÷ that row's best. `·` = no port in that table; a superscript "
          "like <sup>12/15</sup> means that column scored over only those rows, so it is "
          "not a like-for-like comparison with the full-coverage columns beside it. (The colour "
          "bands are on the `vs best` / `vs avg` columns in the tables below: 🟢 at least "
          "as fast · 🟠 up to 3× slower · 🔴 beyond.)")
        (end "SCOREBOARD")])))

;; ---- the document walk -----------------------------------------------------------

(defn- drop-last (v) (vec (take v (dec (count v)))))

(defn- skip-to-end (lines i block)
  "The index just past `block`'s END marker (or the end of the document)."
  (letrec (go (fn (j)
                (cond
                  (>= j (count lines)) j
                  (string/starts-with? (nth lines j) (end block)) (inc j)
                  else (go (inc j)))))
    (go i)))

(defn- copy-to-end (lines i block out)
  "`[out i]` with every line from `i` up to (not including) `block`'s END marker copied."
  (letrec (go (fn (j acc)
                (if (or (>= j (count lines)) (string/starts-with? (nth lines j) (end block)))
                  [acc j]
                  (go (inc j) (conj acc (nth lines j))))))
    (go i out)))

(defn- table-body (lines from)
  "The row names a table covers, from its first data line `from` on."
  (letrec (go (fn (j acc)
                (if (>= j (count lines))
                  acc
                  (let (probe (nth lines j))
                    (if (string/starts-with? probe "| **score")
                      (go (inc j) acc)
                      (let (m (regex/find "^\\| `([a-z0-9-]+)`" probe))
                        (if m (go (inc j) (conj acc (get (first (get m :groups)) :text))) acc)))))))
    (go from [])))

(defn- trim-score-tail (out)
  (if (and (not (empty? out))
        (or (empty? (string/trim (last out))) (string/starts-with? (last out) score-prefix)))
    (trim-score-tail (drop-last out))
    out))

(defn- data-row (results starts cols rated line)
  "The regenerated table line for `line`, or nil when it is not a data row."
  (let (m (regex/find "^\\| `([a-z0-9-]+)`( <sup>[a-z]</sup>)?( \\(wall\\))? \\|" line))
    (if (nil? m)
      nil
      (let (groups (get m :groups)
            name (get (nth groups 0) :text)
            sup (or (get (nth groups 1) :text) "")
            wall (or (get (nth groups 2) :text) "")
            vals (row-values results starts name cols)
            present (vec (seq/filter vals (fn ([_ v]) (not (nil? v)))))
            rank (inc (index-of (vec (map (sort-by present second) first)) "Brood"))
            cells (map vals (fn ([n v]) (if (= n "Brood") (str "**" (fmt-ms v) "**") (fmt-ms v))))
            b (value-of present "Brood")
            tail (str " | "
                   rank
                   "/"
                   (count present)
                   " |"
                   (if rated (str " " (rating b present) " | " (rating-avg b present) " |") "")))
        (str "| `" name "`" sup wall " | " (string/join cells " | ") tail)))))

(defn- data-rows (results starts cols rated lines i out)
  "`[out i rows]` — every data row from `i` regenerated, stopping at the first line that is
not one."
  (letrec (go (fn (j acc n)
                (if (or (>= j (count lines)) (not (string/starts-with? (nth lines j) "|")))
                  [acc j n]
                  (let (regenerated (data-row results starts cols rated (nth lines j)))
                    (if (nil? regenerated) [acc j n] (go (inc j) (conj acc regenerated) (inc n)))))))
    (go i out 0)))

(defn- heading-of (line)
  (let (stripped (regex/replace "\\*\\*" (regex/replace "^#+ " line "") "")
        before-dash (first (string/split stripped " —"))
        before-dot (string/trim (first (string/split before-dash "."))))
    (regex/replace "^Brood against (the |its )?" before-dot "")))

(defn- regenerate-table (results starts lines st)
  "One ordered per-row table, at `(:i st)` (its header line)."
  (let (i (get st :i)
        line (nth lines i)
        cols (langs-of-header line)
        cell-of (into {} (header-cells line))
        body (table-body lines (+ i 2))
        out (conj (trim-score-tail (get st :out)) "")
        ;; The codec table is rated by nothing: its denominators are 2-6 ms of native
        ;; library time, the ratio its own note tells you not to read.
        is-codec (= (vec (take body 1)) ["json"])
        rated (not is-codec)
        ;; Columns run fastest -> slowest, which the prose promises and a hand-kept header
        ;; cannot guarantee: Elixir sat left of Node on the like-for-like table while
        ;; scoring 1.65 to its 1.62. Ordered by the same score the top row reports.
        sc (score-map results starts body cols)
        cols (sort-by cols (fn ([n _]) (let (s (value-of sc n)) (if (nil? s) 1.0e308 s))))
        header (string/replace (str "| benchmark | "
                                 (string/join (map cols (fn ([n _]) (get cell-of n))) " | ")
                                 " |"
                                 (if rated " Brood rank | vs best | vs avg |" " Brood rank |"))
                 "| |" "|")
        out (conj out header)
        i (+ i 2)
        out (conj out (str (string/repeat "|---" (+ (count cols) 2 (if rated 2 0))) "|"))
        heading (get st :heading)
        label (if (contains? (get st :seen) heading) (str heading " (context)") heading)
        st (if rated
             (assoc st
               :seen (conj (get st :seen) label)
               :collected (conj (get st :collected) [label cols body]))
             st)
        sr (if rated (score-row results starts body cols) nil)
        out (if sr (conj out sr) out)
        ;; Skip the previous run's score row: it is a `|` line the data-row match below does
        ;; not match, so leaving it would break out of the row loop and copy every data row
        ;; through UNREGENERATED — stale numbers, silently. (Caught by the row counter
        ;; reading 3 instead of 39.)
        i (if (and (< i (count lines)) (string/starts-with? (nth lines i) "| **score")) (inc i) i)
        [out i n] (data-rows results starts cols rated lines i out))
    (assoc st :out out :i i :tables (inc (get st :tables)) :rows (+ (get st :rows) n))))

(defn- walk (results starts fill lines st)
  (let (i (get st :i))
    (if (>= i (count lines))
      st
      (let (line (nth lines i)
            st (if (or (string/starts-with? line "### ")
                     (string/starts-with? line "**Brood against"))
                 (assoc st :heading (heading-of line))
                 st)
            m (regex/find begin-re line)
            block (if m (get (first (get m :groups)) :text) nil))
        (cond
          (and (= block "SCOREBOARD") (nil? fill))
          ;; pass 1: leave it untouched
            (let ([out j] (copy-to-end lines (inc i) "SCOREBOARD" (conj (get st :out) line)))
              (walk results starts fill lines (assoc st :out out :i j)))
          (= block "SCOREBOARD")
            (walk results
              starts
              fill
              lines
              (assoc st
                :out (into (get st :out) (scoreboard-block results starts fill))
                :blocks (inc (get st :blocks))
                :i (skip-to-end lines i "SCOREBOARD")))
          (and block (not (nil? (block-lines block results starts))))
            (walk results
              starts
              fill
              lines
              (assoc st
                :out (into (get st :out) (block-lines block results starts))
                :blocks (inc (get st :blocks))
                ;; past the END marker (the generator emits its own)
                :i (skip-to-end lines i block)))
          (and (string/starts-with? line "| benchmark |") (includes? line "Brood rank"))
            (walk results starts fill lines (regenerate-table results starts lines st))
          else (walk results starts fill lines (assoc st :out (conj (get st :out) line) :i (inc i))))))))

(defn regenerate (text results starts &optional (fill nil))
  "Rewrite every generated block and ordered table in one document: `{:text :tables :rows
:blocks :collected}`. Two passes, because the SCOREBOARD sits *above* the tables it
summarises: pass 1 (no `fill`) learns each table's `[label columns rows]` as `:collected`,
pass 2 passes those as `fill` to emit the board."
  (let (st (walk results
             starts
             fill
             (vec (string/split text "\n"))
             {:out [] :i 0 :tables 0 :rows 0 :blocks 0 :heading "" :seen #{} :collected []}))
    {:text (string/join (get st :out) "\n")
     :tables (get st :tables)
     :rows (get st :rows)
     :blocks (get st :blocks)
     :collected (get st :collected)}))

(defn- regenerate-doc (path results starts)
  (let (before (file/slurp path)
        specs (get (regenerate before results starts) :collected)
        after (regenerate before results starts specs))
    (assoc after :path path :before before)))

(defn main (& arguments)
  "`nest run -- docs [--check] [--results PATH]` — regenerate the docs in
place, or with `--check` exit 1 when either is stale."
  (let (options (bench/cli/parse {"check" {:kind :flag :default false}
                                  "results" {:kind :string :default results-path}}
                  arguments)
        check (get options :check)
        [results starts] (load-results (get options :results))
        done (vec (map docs (fn (path) (regenerate-doc path results starts))))
        stale (vec (seq/filter done (fn (d) (not (= (get d :before) (get d :text))))))
        total (fn (k) (fold done 0 (fn (acc d) (+ acc (get d k)))))
        what (str (total :tables) " tables, " (total :rows) " rows, " (total :blocks) " blocks")
        stale-names (string/join (map stale (fn (d) (get d :path))) ", "))
    (cond
      (and check (not (empty? stale)))
        (do
          (io/puts (str "stale, run `nest run -- docs`: " stale-names) :to *err*)
          (system/halt 1))
      check (io/puts (str "docs up to date (" what ")"))
      else
        (do
          (doseq (d stale) (file/spit (get d :path) (get d :text)))
          (io/puts (str "regenerated "
                     what
                     (if (empty? stale) " — already current" (str " — updated " stale-names))))))))
