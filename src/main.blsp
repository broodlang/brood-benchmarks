(defmodule main
  "Placeholder entry point: this repo is driven by `python3 bench/harness.py`,
not `nest run` — the module exists only so the nest project (and its `nest mcp`
server, see .mcp.json) loads. The benchmark programs live under bench/brood/.")

(defn main ()
  "Point the caller at the real entry point."
  (io/puts "run: python3 bench/harness.py  (see README.md)"))
